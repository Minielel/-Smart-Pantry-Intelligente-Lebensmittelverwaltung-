<!--
Datei: RecipesView.xaml

Beschreibung:
Diese XAML-Datei beschreibt das Aussehen einer Seite der App. Hier wird festgelegt, wie die Benutzeroberflaeche aufgebaut ist und welche Steuerelemente angezeigt werden.

Hinweis fuer die Vorstellung:
Wenn man diese Datei erklaert, kann man sagen, dass XAML nur fuer den sichtbaren
Aufbau zustaendig ist. Die eigentliche Logik liegt meistens im passenden ViewModel.
-->



<UserControl x:Class="SmartPantry2.Views.RecipesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource Title_Recipes}" FontSize="34" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="60"/>
            </Grid.ColumnDefinitions>

            
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0">
                <StackPanel>
                    <Border Style="{StaticResource PillHeaderBorderStyle}" Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource PillHeaderTextStyle}" Text="{DynamicResource Recipes_ListHeader}"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!-- In dieser Liste werden die vorhandenen Rezepte dargestellt. -->
<ListBox ItemsSource="{Binding Recipes}"
                                 SelectedItem="{Binding SelectedRecipe}"
                                 BorderThickness="0"
                                 Background="Transparent">
                            <!-- In dieser Liste werden die vorhandenen Rezepte dargestellt. -->
<ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,10"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <!-- In dieser Liste werden die vorhandenen Rezepte dargestellt. -->
<ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Border Style="{StaticResource CardBorderStyle}" Background="{DynamicResource Surface2Brush}" Margin="0" Padding="14">
                                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold"/>
                                        </Border>

                                        
                                        <Button Content="✕" Width="26" Height="26" Padding="0"
                                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Background="#33FFFFFF" BorderThickness="0"
                                                Command="{Binding DataContext.DeleteRecipeTileCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}" Margin="0" IsEnabled="{Binding CanEdit}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource PillHeaderBorderStyle}" Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource PillHeaderTextStyle}" Text="{DynamicResource Recipes_DetailHeader}"/>
                    </Border>

                    <Grid Grid.Row="1" Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="260"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <TextBlock Text="{DynamicResource Label_Name}" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBox Text="{Binding RecipeName, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Text="{DynamicResource Recipes_Description}" Foreground="{DynamicResource MutedTextBrush}" Margin="0,10,0,0"/>
                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="60" TextWrapping="Wrap"/>
                        </StackPanel>

                        
                        <Border Grid.Column="2" Background="#FFDAD5CF" CornerRadius="16" Padding="10">
                            <StackPanel>
                                <Border Height="120" CornerRadius="12" Background="#FFC9C3BD" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding SelectedImagePath}" Stretch="UniformToFill"/>
                                        <TextBlock Text="+" FontSize="28" Opacity="0.35" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                                <Button Content="{DynamicResource Btn_AddImage}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,10,0,0"
                                        Command="{Binding PickImageCommand}"/>
                                <TextBlock Text="{Binding SelectedImagePath}" FontSize="10" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        
                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="16" Padding="14">
                            <StackPanel>
                                <Border Style="{StaticResource PillHeaderBorderStyle}" Margin="0,0,0,10">
                                    <TextBlock Style="{StaticResource PillHeaderTextStyle}" Text="{DynamicResource Recipes_Ingredients}"/>
                                </Border>

                                <!-- In dieser Liste werden die vorhandenen Rezepte dargestellt. -->
<ListBox ItemsSource="{Binding Ingredients}" SelectedItem="{Binding SelectedIngredient}" BorderThickness="0" Background="Transparent" Height="120">
                                    <!-- In dieser Liste werden die vorhandenen Rezepte dargestellt. -->
<ListBox.ItemTemplate>
                                        <DataTemplate>
	                                            
	                                            <StackPanel Orientation="Horizontal">
	                                                <TextBlock Text="{Binding FoodItem}" Width="150" Margin="0,0,10,0"/>
	                                                <TextBlock Text="{Binding Amount}" Width="60" Margin="0,0,10,0"/>
	                                                <TextBlock Text="{Binding Unit}" Width="80"/>
	                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBox Text="{Binding NewIngredientName}" Width="150" Margin="0,0,10,0"/>
                                    <TextBox Text="{Binding NewIngredientAmount}" Width="60" Margin="0,0,10,0"/>
                                    <ComboBox ItemsSource="{Binding IngredientUnits}" SelectedItem="{Binding SelectedIngredientUnit}" Width="110"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Content="+" Width="44" Height="34" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding AddIngredientCommand}"/>
                                    <Button Content="{DynamicResource Btn_AddIngredient}" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding PickFoodForIngredientCommand}"/>
                                    <Button Content="{DynamicResource Btn_RemoveIngredient}" Margin="10,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RemoveIngredientCommand}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        
                        <Border Grid.Column="2" Background="{DynamicResource AccentBrush}" CornerRadius="16" Padding="14">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Recipes_Instructions}" Foreground="White" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding Instructions}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="220"/>
                                <Button Content="{DynamicResource Btn_Add}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0" Command="{Binding AddRecipeCommand}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="DarkRed" Margin="0,10,0,0" TextWrapping="Wrap"/>
                </Grid>
            </Border>

            
            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Button Content="+" Width="56" Height="56" Style="{StaticResource FloatingIconButtonStyle}" Command="{Binding NewRecipeCommand}" ToolTip="Neues Rezept"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
