<!--
Datei: FoodView.xaml

Beschreibung:
Diese XAML-Datei beschreibt das Aussehen einer Seite der App. Hier wird festgelegt, wie die Benutzeroberflaeche aufgebaut ist und welche Steuerelemente angezeigt werden.

Hinweis fuer die Vorstellung:
Wenn man diese Datei erklaert, kann man sagen, dass XAML nur fuer den sichtbaren
Aufbau zustaendig ist. Die eigentliche Logik liegt meistens im passenden ViewModel.
-->



<UserControl x:Class="SmartPantry2.Views.FoodView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource Title_Food}" FontSize="34" FontWeight="SemiBold" Margin="0,0,0,16"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            
            <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Style="{StaticResource PillHeaderBorderStyle}" Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource PillHeaderTextStyle}" Text="{DynamicResource Food_ListHeader}"/>
                    </Border>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <!-- In dieser Liste werden alle vorhandenen Lebensmittel angezeigt. -->
<ListBox ItemsSource="{Binding FoodItems}"
                                 SelectedItem="{Binding SelectedFoodItem}"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <!-- In dieser Liste werden alle vorhandenen Lebensmittel angezeigt. -->
<ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>

                            <!-- In dieser Liste werden alle vorhandenen Lebensmittel angezeigt. -->
<ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>

                            <!-- In dieser Liste werden alle vorhandenen Lebensmittel angezeigt. -->
<ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource CardBorderStyle}" Width="170" Height="120" Background="{DynamicResource Surface2Brush}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <StackPanel>
                                                <TextBlock Text="{Binding Amount}" FontSize="18" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Unit}" FontSize="14" Foreground="{DynamicResource MutedTextBrush}"/>
                                            </StackPanel>

                                            <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextTrimming="CharacterEllipsis"/>

                                            
                                            <Button Width="22" Height="22"
                                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Background="#33FFFFFF" BorderThickness="0"
                                                    Command="{Binding DataContext.DeleteFoodItemCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Button.Template>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="11">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </ControlTemplate>
                                                </Button.Template>
                                                <TextBlock Text="×" Foreground="{DynamicResource MutedTextBrush}" FontWeight="SemiBold"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
</DockPanel>
            </Border>

            
            <Border Grid.Column="2" Margin="0" IsEnabled="{Binding CanEdit}">
                <Border.Style>
                    <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="Grid.Column" Value="2"/>
                        <Setter Property="IsEnabled" Value="{Binding CanEdit}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CanEdit}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Border Style="{StaticResource PillHeaderBorderStyle}" Margin="0,0,0,14">
                        <TextBlock Style="{StaticResource PillHeaderTextStyle}" Text="{DynamicResource Food_AddHeader}"/>
                    </Border>

                    <TextBlock Text="{DynamicResource Label_Name}" Foreground="{DynamicResource MutedTextBrush}"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Orientation="Horizontal">
                        <StackPanel Width="160" Margin="0,0,10,0">
                            <TextBlock Text="{DynamicResource Label_Amount}" Foreground="{DynamicResource MutedTextBrush}"/>
                            <TextBox Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                        <StackPanel Width="160">
                            <TextBlock Text="{DynamicResource Label_Unit}" Foreground="{DynamicResource MutedTextBrush}"/>
                            <ComboBox ItemsSource="{Binding Units}"
                                      SelectedItem="{Binding SelectedUnit, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource Label_ExpiryDate}" Foreground="{DynamicResource MutedTextBrush}"/>
                    <DatePicker SelectedDate="{Binding ExpiryDate}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Style="{StaticResource PrimaryButtonStyle}" Content="{DynamicResource Btn_Add}" Command="{Binding AddCommand}" MinWidth="120"/>
                    </StackPanel>

                    <TextBlock Text="{Binding StatusMessage}" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
