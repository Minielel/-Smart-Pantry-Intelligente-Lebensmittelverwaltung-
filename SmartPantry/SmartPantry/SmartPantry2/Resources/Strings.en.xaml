<!--
====================================================================
Datei:   Strings.en.xaml
Schicht: Ressourcen / Lokalisierung

ZWECK:
  Enthält alle englischen UI-Texte der App.
  Identische x:Key-Namen wie Strings.de.xaml →
  wird einfach ausgetauscht wenn User "English" wählt.

ROTER FADEN:
  SettingsViewModel.SetLanguage("en")
    → ApplyLanguageResources("en")
      → ResourceSwapService.SwapMergedDictionary("Strings.", Strings.en.xaml)
        → DIESE Datei ersetzt Strings.de.xaml im MergedDictionaries-Stack
          → alle {DynamicResource Nav_Dashboard} zeigen "Dashboard" (gleich)
          → alle {DynamicResource Nav_Food} zeigen "Pantry" (anders als Deutsch)
          → alle {DynamicResource Btn_Add} zeigen "Add" statt "Hinzufügen"

WICHTIG:
  ALLE x:Key-Namen müssen identisch mit Strings.de.xaml sein!
  Fehlt ein Key → WPF findet ihn nicht → Text-Binding zeigt leere Fläche.

VERWENDETE QUELLEN:
  WPF Globalization/Localization:
    https://learn.microsoft.com/dotnet/desktop/wpf/advanced/wpf-globalization-and-localization-overview
  x:Key-Attribut:
    https://learn.microsoft.com/dotnet/desktop/wpf/xaml/xkey-directive
  DynamicResource:
    https://learn.microsoft.com/dotnet/desktop/wpf/systems/xaml-resources-dynamic-static-comparison
  system:String:
    https://learn.microsoft.com/dotnet/api/system.string
====================================================================
-->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

  <!-- ── NAVIGATION ────────────────────────────────────────────────────────── -->
  <!--
    GLEICHE x:Key-Namen wie Strings.de.xaml → direkter Austausch möglich.
    Englische Texte für alle Navigations-Labels.
  -->

  <system:String x:Key="Nav_Dashboard">Dashboard</system:String>

  <!-- "Pantry" statt "Food": englischer Fachbegriff für Vorratskammer -->
  <system:String x:Key="Nav_Food">Pantry</system:String>

  <system:String x:Key="Nav_Recipes">Recipes</system:String>

  <!-- "Plan" für Wochenplan (kurz und prägnant) -->
  <system:String x:Key="Nav_MealPlan">Plan</system:String>

  <system:String x:Key="Nav_Shopping">Shopping</system:String>

  <system:String x:Key="Nav_Settings">Settings</system:String>

  <system:String x:Key="Nav_Logout">Sign Out</system:String>

  <!-- ── BUTTONS ────────────────────────────────────────────────────────────── -->

  <system:String x:Key="Btn_Add">Add</system:String>

  <system:String x:Key="Btn_Save">Save</system:String>

  <system:String x:Key="Btn_Delete">Delete</system:String>

  <system:String x:Key="Btn_Cancel">Cancel</system:String>

  <system:String x:Key="Btn_Login">Sign In</system:String>

  <system:String x:Key="Btn_Register">Register</system:String>

  <!-- ── FORMULAR-LABELS ──────────────────────────────────────────────────────── -->

  <system:String x:Key="Label_Name">Name</system:String>

  <system:String x:Key="Label_Amount">Amount</system:String>

  <system:String x:Key="Label_Unit">Unit</system:String>

  <!-- "Best Before" statt "Ablaufdatum": gebräuchlicher englischer Fachbegriff -->
  <system:String x:Key="Label_ExpiryDate">Best Before</system:String>

  <system:String x:Key="Label_Description">Description</system:String>

  <system:String x:Key="Label_Instructions">Instructions</system:String>

  <!-- ── DASHBOARD-KACHELN ──────────────────────────────────────────────────── -->

  <system:String x:Key="Dashboard_TotalItems">Items in Stock</system:String>

  <system:String x:Key="Dashboard_ExpiringSoon">Expiring Soon</system:String>

  <system:String x:Key="Dashboard_Expired">Expired</system:String>

  <!-- "Ideas" statt "Ideen" für die Rezepte-Kachel -->
  <system:String x:Key="Dashboard_Recipes">Ideas</system:String>

  <!-- ── MAHLZEITTYPEN ──────────────────────────────────────────────────────── -->
  <!--
    Gleiche x:Key-Namen wie in Strings.de.xaml.
    DB-Wert bleibt "breakfast"/"lunch"/"dinner" (englisch),
    nur die Anzeige in der View wechselt.
  -->

  <system:String x:Key="MealType_Breakfast">Morning</system:String>

  <system:String x:Key="MealType_Lunch">Noon</system:String>

  <system:String x:Key="MealType_Dinner">Evening</system:String>

</ResourceDictionary>