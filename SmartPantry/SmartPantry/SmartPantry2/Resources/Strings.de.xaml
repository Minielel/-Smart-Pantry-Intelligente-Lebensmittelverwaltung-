<!--
====================================================================
Datei:   Strings.de.xaml
Schicht: Ressourcen / Lokalisierung

ZWECK:
  Enthält alle deutschen UI-Texte der App als benannte Ressourcen.
  Ermöglicht die Trennung von Text und Layout:
  XAML-Elemente referenzieren Schlüssel, nicht direkte Texte.

ROTER FADEN:
  SettingsViewModel.SetLanguage("de")
    → ApplyLanguageResources("de")
      → ResourceSwapService.SwapMergedDictionary("Strings.", Strings.de.xaml)
        → diese Datei wird als aktives Sprach-Dictionary gesetzt
          → alle {DynamicResource Nav_Dashboard} Bindings zeigen "Dashboard"
          → alle {DynamicResource Nav_Food} Bindings zeigen "Food" usw.

ZUSAMMENSPIEL MIT Strings.en.xaml:
  BEIDE Dateien definieren dieselben x:Key-Namen.
  Sprache wechseln = Dictionary austauschen → alle Texte sofort anders.
  → keine Änderung im XAML-Layout nötig beim Sprachwechsel!

VERWENDUNG IM XAML:
  <TextBlock Text="{DynamicResource Nav_Dashboard}"/>
  <Button Content="{DynamicResource Btn_Add}"/>
  <Label Content="{DynamicResource Label_Name}"/>

VERWENDETE QUELLEN:
  WPF Localization mit ResourceDictionary:
    https://learn.microsoft.com/dotnet/desktop/wpf/advanced/wpf-globalization-and-localization-overview
  x:Key-Attribut:
    https://learn.microsoft.com/dotnet/desktop/wpf/xaml/xkey-directive
  DynamicResource für Live-Sprachwechsel:
    https://learn.microsoft.com/dotnet/desktop/wpf/systems/xaml-resources-dynamic-static-comparison
  system:String (für String-Ressourcen in XAML):
    https://learn.microsoft.com/dotnet/api/system.string
====================================================================
-->

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

  <!-- ── NAVIGATION (Sidebar-Buttons) ──────────────────────────────────────── -->
  <!--
    system:String x:Key="...": definiert einen String als benannte Ressource.
    x:Key: der Name mit dem {DynamicResource Nav_Dashboard} diese Ressource findet.
    Quelle system:String: https://learn.microsoft.com/dotnet/api/system.string
  -->

  <!-- Navigations-Label: Startseite mit Statistiken -->
  <system:String x:Key="Nav_Dashboard">Dashboard</system:String>

  <!-- Navigations-Label: Vorratsverwaltung -->
  <system:String x:Key="Nav_Food">Food</system:String>

  <!-- Navigations-Label: Rezepte-Verwaltung -->
  <system:String x:Key="Nav_Recipes">Rezepte</system:String>

  <!-- Navigations-Label: Wochenplan -->
  <system:String x:Key="Nav_MealPlan">Plan</system:String>

  <!-- Navigations-Label: Einkaufsliste -->
  <system:String x:Key="Nav_Shopping">Einkauf</system:String>

  <!-- Navigations-Label: Einstellungen -->
  <system:String x:Key="Nav_Settings">Einstellungen</system:String>

  <!-- Navigations-Label: Ausloggen -->
  <system:String x:Key="Nav_Logout">Abmelden</system:String>

  <!-- ── BUTTONS ────────────────────────────────────────────────────────────── -->

  <!-- Allgemeiner Hinzufügen-Button (Formular-Bestätigung) -->
  <system:String x:Key="Btn_Add">Hinzufügen</system:String>

  <!-- Speichern-Button in SettingsView -->
  <system:String x:Key="Btn_Save">Speichern</system:String>

  <!-- Löschen-Button (auf Kacheln und in Listen) -->
  <system:String x:Key="Btn_Delete">Löschen</system:String>

  <!-- Abbrechen-Button (z.B. Auswahlmodus verlassen) -->
  <system:String x:Key="Btn_Cancel">Abbrechen</system:String>

  <!-- Login-Button in LoginView -->
  <system:String x:Key="Btn_Login">Anmelden</system:String>

  <!-- Registrier-Button in LoginView -->
  <system:String x:Key="Btn_Register">Registrieren</system:String>

  <!-- ── FORMULAR-LABELS ──────────────────────────────────────────────────────── -->

  <!-- Label für Name-Eingabefelder (Food, Rezept, Zutat) -->
  <system:String x:Key="Label_Name">Name</system:String>

  <!-- Label für Mengen-Eingabefelder -->
  <system:String x:Key="Label_Amount">Menge</system:String>

  <!-- Label für Einheit-Eingabefelder -->
  <system:String x:Key="Label_Unit">Einheit</system:String>

  <!-- Label für Ablaufdatum-DatePicker -->
  <system:String x:Key="Label_ExpiryDate">Ablaufdatum</system:String>

  <!-- Label für Beschreibungs-Textfelder (Rezepte) -->
  <system:String x:Key="Label_Description">Beschreibung</system:String>

  <!-- Label für Anleitungs-Textfelder (Rezepte) -->
  <system:String x:Key="Label_Instructions">Anleitung</system:String>

  <!-- ── DASHBOARD-KACHELN ──────────────────────────────────────────────────── -->

  <!-- Kachel: Gesamtanzahl der Lebensmittel -->
  <system:String x:Key="Dashboard_TotalItems">Items im Vorrat</system:String>

  <!-- Kachel: bald ablaufende Items (gelbe Warnung) -->
  <system:String x:Key="Dashboard_ExpiringSoon">Läuft bald ab</system:String>

  <!-- Kachel: bereits abgelaufene Items (rote Warnung) -->
  <system:String x:Key="Dashboard_Expired">Abgelaufen</system:String>

  <!-- Kachel: Anzahl der Rezepte -->
  <system:String x:Key="Dashboard_Recipes">Ideen</system:String>

  <!-- ── MAHLZEITTYPEN (für MealPlanView Anzeige) ───────────────────────────── -->
  <!--
    Diese Strings werden in MealPlanView.xaml per DataTrigger genutzt:
    <DataTrigger Binding="{Binding MealType}" Value="breakfast">
        <Setter Property="Text" Value="{DynamicResource MealType_Breakfast}"/>
    </DataTrigger>
    DB speichert englische Werte, View zeigt deutsche Texte.
  -->

  <!-- "breakfast" → Morgens -->
  <system:String x:Key="MealType_Breakfast">Morgens</system:String>

  <!-- "lunch" → Mittags -->
  <system:String x:Key="MealType_Lunch">Mittags</system:String>

  <!-- "dinner" → Abends -->
  <system:String x:Key="MealType_Dinner">Abends</system:String>

</ResourceDictionary>